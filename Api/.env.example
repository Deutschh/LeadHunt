NODE_ENV=development
PORT=3001

# Auth foundation (server-side only)
AUTH_OTP_HMAC_SECRET=CHANGE_ME
AUTH_TERMS_VERSION=2026-08
AUTH_PRIVACY_POLICY_VERSION=2026-08
AUTH_EMAIL_FROM=LeadHunt <no-reply@example.com>
RESEND_API_KEY=re_replace_me

# Session Auth. Sentinels are intentionally invalid as secrets.
AUTH_JWT_SECRET=CHANGE_ME
AUTH_JWT_KEY_ID=v1
AUTH_JWT_ISSUER=leadhunt-api
AUTH_JWT_AUDIENCE=leadhunt-web
AUTH_REFRESH_COOKIE_NAME=leadhunt_refresh

# Exact REST origins, comma-separated. Production accepts HTTPS only.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 0 means the client connects directly. Production must set this explicitly
# to the verified number of trusted reverse-proxy hops.
TRUST_PROXY_HOPS=0

# Development-only e-mail verification bypass. Never enable in production.
DEV_EMAIL_BYPASS_ENABLED=false
DEV_EMAIL_BYPASS_CODE=
